<?xml version="1.0" encoding="utf-8"?>
<!-- Contrast panel (EinkPanels): tap a block, or use -/+. Segments are added in code. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#ffffff"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        style="@style/PanelLabel"
        android:gravity="center"
        android:text="@string/panel_contrast_title"
        android:textSize="22sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/contrastDown"
            style="@style/PanelButton"
            android:text="−" />

        <LinearLayout
            android:id="@+id/contrastSegments"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="12dp"
            android:layout_weight="1"
            android:orientation="horizontal" />

        <TextView
            android:id="@+id/contrastUp"
            style="@style/PanelButton"
            android:text="+" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/contrastRefreshMode"
            style="@style/PanelAction"
            android:text="@string/panel_refresh_mode" />

        <Space
            android:layout_width="12dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/panelDone"
            style="@style/PanelAction"
            android:text="@string/app_manager_finish" />
    </LinearLayout>
</LinearLayout>
