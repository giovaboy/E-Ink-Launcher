<?xml version="1.0" encoding="utf-8"?>
<!-- Front light panel (EinkPanels): brightness and color temperature with big +/- buttons. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#ffffff"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        style="@style/PanelLabel"
        android:gravity="center"
        android:text="@string/panel_light_title"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/lightBrightnessLabel"
        style="@style/PanelLabel"
        android:layout_marginTop="20dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/lightBrightnessDown"
            style="@style/PanelButton"
            android:text="−" />

        <ProgressBar
            android:id="@+id/lightBrightnessBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="12dp"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="12dp"
            android:layout_weight="1"
            android:max="24"
            android:progressDrawable="@drawable/reading_progress" />

        <TextView
            android:id="@+id/lightBrightnessUp"
            style="@style/PanelButton"
            android:text="+" />
    </LinearLayout>

    <TextView
        android:id="@+id/lightTemperatureLabel"
        style="@style/PanelLabel"
        android:layout_marginTop="20dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/lightTemperatureDown"
            style="@style/PanelButton"
            android:text="−" />

        <ProgressBar
            android:id="@+id/lightTemperatureBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="12dp"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="12dp"
            android:layout_weight="1"
            android:max="24"
            android:progressDrawable="@drawable/reading_progress" />

        <TextView
            android:id="@+id/lightTemperatureUp"
            style="@style/PanelButton"
            android:text="+" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/lightToggle"
            style="@style/PanelAction" />

        <Space
            android:layout_width="12dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/panelDone"
            style="@style/PanelAction"
            android:text="@string/app_manager_finish" />
    </LinearLayout>
</LinearLayout>
