<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher settings: a centered modal card over the home screen (SettingFragment).
  Changes apply right away, so the grid behind updates live. Tapping outside closes it.
  No dimmed backdrop: translucent layers turn into a dither pattern on e-ink.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="true"
    android:padding="20dp">

    <LinearLayout
        android:id="@+id/settingsCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/settings_card"
        android:clickable="true"
        android:orientation="vertical"
        android:padding="2dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="20dp">

            <!-- Back to the settings list, shown with Help & About -->
            <TextView
                android:id="@+id/settingsBack"
                android:layout_width="44dp"
                android:layout_height="60dp"
                android:layout_marginLeft="-12dp"
                android:background="?android:selectableItemBackground"
                android:contentDescription="@string/settings_title"
                android:gravity="center"
                android:text="‹"
                android:textColor="#000000"
                android:textSize="32sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/settingsTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_title"
                android:textColor="#000000"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/helpAbout"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="@drawable/info_button"
                android:contentDescription="@string/setting_help_and_about"
                android:fontFamily="serif"
                android:gravity="center"
                android:text="i"
                android:textColor="@color/panel_button_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/toBack"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="?android:selectableItemBackground"
                android:contentDescription="@string/dialog_close"
                android:gravity="center"
                android:text="✕"
                android:textColor="#000000"
                android:textSize="24sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="#000000" />

        <ScrollView
            android:id="@+id/settingsScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fadeScrollbars="false"
            android:scrollbarThumbVertical="@drawable/scrollbar_thumb"
            android:fadingEdge="none"
            android:overScrollMode="never">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

            <include
                layout="@layout/about_content"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/settingsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="12dp">

                <!-- Grid -->
                <TextView
                    style="@style/SettingsSection"
                    android:text="@string/settings_section_grid" />

                <LinearLayout style="@style/SettingsRow">

                    <TextView
                        style="@style/SettingsLabel"
                        android:text="@string/settings_columns" />

                    <TextView
                        android:id="@+id/colDown"
                        style="@style/SettingsStepButton"
                        android:text="−" />

                    <TextView
                        android:id="@+id/colValue"
                        style="@style/SettingsStepValue" />

                    <TextView
                        android:id="@+id/colUp"
                        style="@style/SettingsStepButton"
                        android:text="+" />
                </LinearLayout>

                <LinearLayout style="@style/SettingsRow">

                    <TextView
                        style="@style/SettingsLabel"
                        android:text="@string/settings_rows" />

                    <TextView
                        android:id="@+id/rowDown"
                        style="@style/SettingsStepButton"
                        android:text="−" />

                    <TextView
                        android:id="@+id/rowValue"
                        style="@style/SettingsStepValue" />

                    <TextView
                        android:id="@+id/rowUp"
                        style="@style/SettingsStepButton"
                        android:text="+" />
                </LinearLayout>

                <LinearLayout style="@style/SettingsRow">

                    <TextView
                        style="@style/SettingsLabel"
                        android:text="@string/setting_set_font_size" />

                    <TextView
                        android:id="@+id/fontDown"
                        style="@style/SettingsStepButton"
                        android:text="−" />

                    <TextView
                        android:id="@+id/fontValue"
                        style="@style/SettingsStepValue" />

                    <TextView
                        android:id="@+id/fontUp"
                        style="@style/SettingsStepButton"
                        android:text="+" />
                </LinearLayout>

                <TextView
                    style="@style/SettingsLabel"
                    android:layout_width="match_parent"
                    android:paddingLeft="20dp"
                    android:paddingTop="10dp"
                    android:text="@string/item_title_display" />

                <LinearLayout
                    android:id="@+id/titleLinesSegments"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingLeft="20dp"
                    android:paddingTop="8dp"
                    android:paddingRight="16dp"
                    android:paddingBottom="8dp">

                    <TextView
                        style="@style/SettingsSegment"
                        android:text="@string/settings_title_lines_none" />

                    <TextView
                        style="@style/SettingsSegment"
                        android:layout_marginLeft="6dp"
                        android:text="1" />

                    <TextView
                        style="@style/SettingsSegment"
                        android:layout_marginLeft="6dp"
                        android:text="2" />

                    <TextView
                        style="@style/SettingsSegment"
                        android:layout_marginLeft="6dp"
                        android:text="@string/settings_title_lines_all" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/sortMethod"
                    style="@style/SettingsRow"
                    android:background="?android:selectableItemBackground">

                    <TextView
                        style="@style/SettingsLabel"
                        android:text="@string/sort_method" />

                    <TextView
                        android:id="@+id/sortMethodValue"
                        style="@style/SettingsValue" />

                    <TextView
                        style="@style/SettingsValue"
                        android:text="›"
                        android:textSize="22sp" />
                </LinearLayout>

                <View style="@style/SettingsDivider" />

                <!-- Show -->
                <TextView
                    style="@style/SettingsSection"
                    android:text="@string/settings_section_show" />

                <LinearLayout
                    android:id="@+id/toggleDivider"
                    style="@style/SettingsRow"
                    android:background="?android:selectableItemBackground">

                    <TextView
                        style="@style/SettingsLabel"
                        android:text="@string/settings_dividers" />

                    <Switch
                        android:id="@+id/switchDivider"
                        style="@style/SettingsSwitch" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/toggleStatusBar"
                    style="@style/SettingsRow"
                    android:background="?android:selectableItemBackground">

                    <TextView
                        style="@style/SettingsLabel"
                        android:text="@string/settings_status_bar" />

                    <Switch
                        android:id="@+id/switchStatusBar"
                        style="@style/SettingsSwitch" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/toggleCustomIcon"
                    style="@style/SettingsRow"
                    android:background="?android:selectableItemBackground">

                    <TextView
                        style="@style/SettingsLabel"
                        android:text="@string/settings_custom_icons" />

                    <Switch
                        android:id="@+id/switchCustomIcon"
                        style="@style/SettingsSwitch" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/toggleReadingCard"
                    style="@style/SettingsRow"
                    android:background="?android:selectableItemBackground">

                    <TextView
                        style="@style/SettingsLabel"
                        android:text="@string/settings_reading_card" />

                    <Switch
                        android:id="@+id/switchReadingCard"
                        style="@style/SettingsSwitch" />
                </LinearLayout>

                <TextView
                    style="@style/SettingsLabel"
                    android:layout_width="match_parent"
                    android:paddingLeft="20dp"
                    android:paddingTop="10dp"
                    android:text="@string/settings_battery" />

                <LinearLayout
                    android:id="@+id/batteryStyleSegments"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingLeft="20dp"
                    android:paddingTop="8dp"
                    android:paddingRight="16dp"
                    android:paddingBottom="8dp">

                    <!-- Same order as BatteryView.STYLE_ICON, STYLE_RING, STYLE_TEXT -->
                    <TextView
                        style="@style/SettingsSegment"
                        android:text="@string/settings_battery_icon" />

                    <TextView
                        style="@style/SettingsSegment"
                        android:layout_marginLeft="6dp"
                        android:text="@string/settings_battery_ring" />

                    <TextView
                        style="@style/SettingsSegment"
                        android:layout_marginLeft="6dp"
                        android:text="@string/settings_battery_text" />
                </LinearLayout>

                <View style="@style/SettingsDivider" />

                <!-- Quick bar: one switch per item, added by SettingFragment -->
                <TextView
                    style="@style/SettingsSection"
                    android:text="@string/settings_section_quick_bar" />

                <LinearLayout
                    android:id="@+id/quickItemToggles"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <View style="@style/SettingsDivider" />

                <!-- More -->
                <TextView
                    style="@style/SettingsSection"
                    android:text="@string/settings_section_more" />

                <LinearLayout
                    android:id="@+id/menu_ftp"
                    style="@style/SettingsRow"
                    android:background="?android:selectableItemBackground">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_ftp"
                            android:textColor="#000000"
                            android:textSize="18sp" />

                        <TextView
                            android:id="@+id/ftp_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#000000"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <Switch
                        android:id="@+id/switchFtp"
                        style="@style/SettingsSwitch" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/showWifiName"
                    style="@style/SettingsRow"
                    android:background="?android:selectableItemBackground">

                    <TextView
                        style="@style/SettingsLabel"
                        android:text="@string/show_wifi_name" />

                    <TextView
                        style="@style/SettingsValue"
                        android:text="›"
                        android:textSize="22sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/manageApps"
                    style="@style/SettingsRow"
                    android:background="?android:selectableItemBackground">

                    <TextView
                        style="@style/SettingsLabel"
                        android:text="@string/setting_apps_manager" />

                    <TextView
                        style="@style/SettingsValue"
                        android:text="›"
                        android:textSize="22sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/toSort"
                    style="@style/SettingsRow"
                    android:background="?android:selectableItemBackground">

                    <TextView
                        style="@style/SettingsLabel"
                        android:text="@string/setting_sort" />

                    <TextView
                        style="@style/SettingsValue"
                        android:text="›"
                        android:textSize="22sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/language"
                    style="@style/SettingsRow"
                    android:background="?android:selectableItemBackground">

                    <TextView
                        style="@style/SettingsLabel"
                        android:text="@string/setting_language" />

                    <TextView
                        android:id="@+id/languageValue"
                        style="@style/SettingsValue" />

                    <TextView
                        style="@style/SettingsValue"
                        android:text="›"
                        android:textSize="22sp" />
                </LinearLayout>
            </LinearLayout>
            </FrameLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
